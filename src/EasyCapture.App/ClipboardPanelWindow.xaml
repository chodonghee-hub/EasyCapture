<Window x:Class="EasyCapture.App.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyCapture 클립보드 패널"
        Width="820"
        Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF1E1E1E"
        WindowStartupLocation="Manual"
        FontFamily="Malgun Gothic, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        InputMethod.IsInputMethodEnabled="False">
    <Window.Resources>
        <!-- 포커스를 가져가지 않는 어두운 단추. 키보드 입력이 창의 PreviewKeyDown에 계속 들어오게 한다. -->
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="#FF3A3A3A"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF3C3C3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 머리말: 제목과 선택 개수 -->
            <Grid Grid.Row="0" Margin="14,10,14,6">
                <TextBlock Text="클립보드 패널" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="CountText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#FFA0A0A0"
                           FontSize="12" />
            </Grid>

            <!-- 썸네일 그리드. 키보드 포커스는 이 ScrollViewer가 갖는다. -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="Scroller"
                              Focusable="True"
                              FocusVisualStyle="{x:Null}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Tiles"
                                  Margin="8,0,8,8"
                                  Focusable="False"
                                  ContextMenuService.IsEnabled="False">
                        <ItemsControl.ContextMenu>
                            <ContextMenu x:Name="TileMenu">
                                <MenuItem x:Name="MenuCopy" Header="복사 (Ctrl+C)" />
                                <MenuItem x:Name="MenuPaste" Header="붙여넣기 (Enter)" />
                                <Separator />
                                <MenuItem x:Name="MenuRename" Header="이름 변경 (F2)" />
                                <MenuItem x:Name="MenuOpenFolder" Header="폴더 열기" />
                                <MenuItem x:Name="MenuSaveAs" Header="다른 이름으로 저장…" />
                                <MenuItem x:Name="MenuPin" Header="고정 (Ctrl+P)" />
                                <Separator />
                                <MenuItem x:Name="MenuDelete" Header="삭제 (Del)" />
                            </ContextMenu>
                        </ItemsControl.ContextMenu>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile"
                                        Width="168"
                                        Height="132"
                                        Margin="4"
                                        Background="#FF2A2A2A"
                                        BorderBrush="#FF2A2A2A"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        ToolTip="{Binding ToolTipText}">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="88" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#FF171717" CornerRadius="2">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding PlaceholderText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF808080"
                                                           FontSize="12" />
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,2,0"
                                                        Padding="5,1"
                                                        Background="#E638A0FF"
                                                        CornerRadius="3"
                                                        Visibility="{Binding PinVisibility}">
                                                    <TextBlock Text="고정" Foreground="White" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Caption}"
                                                   Foreground="#FF909090"
                                                   FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCursor}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="#FF8A8A8A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="#FF1F3A57" />
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="#FF38A0FF" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Text="보관된 캡처가 없습니다."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF808080"
                           FontSize="14"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />
            </Grid>

            <!-- 바닥: 오류·결과 안내, 이름 변경 입력, 삭제 확인, 단축키 안내 -->
            <StackPanel Grid.Row="2" Background="#FF252526">
                <TextBlock x:Name="StatusText"
                           Margin="14,6,14,0"
                           Foreground="#FFFFB86B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Grid x:Name="RenameBar" Margin="14,8,14,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="새 이름" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="RenameBox"
                             Grid.Column="1"
                             Background="#FF1E1E1E"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#FF38A0FF"
                             Padding="4,3"
                             FontSize="13"
                             InputMethod.IsInputMethodEnabled="True" />
                    <TextBlock Grid.Column="2" Text="Enter 확인 · Esc 취소" Foreground="#FFA0A0A0" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <Grid x:Name="DeleteBar" Margin="14,8,14,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeleteText"
                               Foreground="White"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="DeleteConfirmButton" Style="{StaticResource PanelButton}" Content="삭제 (Enter)" />
                        <Button x:Name="DeleteCancelButton" Style="{StaticResource PanelButton}" Content="취소 (Esc)" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="HintText"
                           Margin="14,8,14,10"
                           Foreground="#FF8A8A8A"
                           FontSize="11.5"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
